:{env.PORT} {
    root * .
    encode gzip

    # Redirige peticiones a archivos PHP existentes
    php_fastcgi 127.0.0.1:9000

    # Permite servir archivos estáticos (CSS, JS, imágenes)
    file_server

    # Redirige rutas directamente a login.php si se accede a la raíz
    try_files {path} {path}/ /login.php?{query}
}
