            <a class="salir" href="admin.php#pedidos">← Volver</a>
        </div>
    </div>

    <div class="wrap">
        <div class="aviso-edicion">
            Pedido <b>#<?= numeroPedido($pedido["id"]) ?></b> de <b><?= e($pedido["vendedor_nombre"]) ?></b> ·
            Estado: <b><?= e(etiquetaEstadoPedido($pedido["estado"])) ?></b>
            <?php if ($pedido["estado"] === "procesado"): ?>
                <br>⚠️ Ya está marcado como «Subido a Syscafe»: el ejecutivo ya no puede editarlo, pero usted sí.
            <?php endif; ?>
