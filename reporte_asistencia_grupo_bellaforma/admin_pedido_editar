<?php
/** Edición de un pedido desde el panel de administración. */
session_start();

if (!isset($_SESSION["admin_id"])) {
    header("Location: login.html");
    exit;
}

require_once "conexion.php";
require_once "vendedores_db.php";
require_once "pedidos_lib.php";
date_default_timezone_set("America/Bogota");
asegurarTablasVendedores($conexion);

function e($v)
{
    return htmlspecialchars((string) $v, ENT_QUOTES, "UTF-8");
}

$id = (int) ($_GET["id"] ?? 0);
$lista = $id ? obtenerPedidos($conexion, ["con_borradores" => true], null, $id) : [];
$pedido = $lista[0] ?? null;

if (!$pedido) {
    $_SESSION["mensaje"] = "No se encontró el pedido.";
    $_SESSION["tipo_mensaje"] = "error";
    header("Location: admin.php#pedidos");
    exit;
}

if (empty($_SESSION["csrf_pedido"])) {
    $_SESSION["csrf_pedido"] = bin2hex(random_bytes(16));
}

$pf = [
    "rol" => "admin",
    "csrf" => $_SESSION["csrf_pedido"],
    "pedido" => $pedido,
    "productos" => productosParaFormulario($conexion, $pedido),
    "volver" => "admin.php#pedidos",
    "autosave" => false,
    "url_base" => "",
    "texto_enviar" => "Guardar cambios",
];
?>
